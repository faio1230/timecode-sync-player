<Project>
  <!--
    v0.6.6（棚卸しの #37）: 古い native\ の shim でビルドが進む罠を止める。
    csproj は native\tcs_gstreamer.dll があればそれを出力へ写し、build-debug の出力は native\ に DLL が
    無いときだけ使う。native\ に古い DLL が残っていると、shim を作り直してもアプリは古い shim で走る。
    両方に DLL があり、比べる相手（Debug は build-debug、Release は build-release）の方が新しいとき
    ビルドを止める。

    Release では build-release と比べる（build-debug とは比べない）。配布の手順は build-release を
    native\ へ写してから package-release.ps1 を回す（Copy-Item は更新時刻を保つので同時刻になり止まらない）。
    build-debug の方が新しくても Release のビルドは止めない。

    わざと古い shim で走らせるとき: -p:AllowStaleNativeShim=true（止めずに警告を 1 行残す）。
    WPF の 2 回目のマークアップのコンパイル（*_wpftmp.csproj。_TargetAssemblyProjectName が付く）では動かさない
    （同じ判定を 2 回出さない）。
    試験: scripts\test-native-shim-guard.ps1（パスのプロパティを一時フォルダへ向けてこの target だけを呼ぶ）。
  -->
  <PropertyGroup>
    <TcsNativeShimPath Condition="'$(TcsNativeShimPath)' == ''">$(MSBuildThisFileDirectory)..\..\native\tcs_gstreamer.dll</TcsNativeShimPath>
    <TcsShimBuildDirName Condition="'$(TcsShimBuildDirName)' == '' And '$(Configuration)' == 'Release'">build-release</TcsShimBuildDirName>
    <TcsShimBuildDirName Condition="'$(TcsShimBuildDirName)' == ''">build-debug</TcsShimBuildDirName>
    <TcsBuiltShimPath Condition="'$(TcsBuiltShimPath)' == ''">$(MSBuildThisFileDirectory)..\..\native\gst-shim\$(TcsShimBuildDirName)\tcs_gstreamer.dll</TcsBuiltShimPath>
  </PropertyGroup>

  <Target Name="TcsCheckStaleNativeShim"
          BeforeTargets="PrepareForBuild"
          Condition="'$(_TargetAssemblyProjectName)' == '' And Exists('$(TcsNativeShimPath)') And Exists('$(TcsBuiltShimPath)')">
    <PropertyGroup>
      <_TcsNativeShimFull>$([System.IO.Path]::GetFullPath('$(TcsNativeShimPath)'))</_TcsNativeShimFull>
      <_TcsBuiltShimFull>$([System.IO.Path]::GetFullPath('$(TcsBuiltShimPath)'))</_TcsBuiltShimFull>
      <_TcsNativeShimTicks>$([System.IO.File]::GetLastWriteTime('$(_TcsNativeShimFull)').Ticks)</_TcsNativeShimTicks>
      <_TcsBuiltShimTicks>$([System.IO.File]::GetLastWriteTime('$(_TcsBuiltShimFull)').Ticks)</_TcsBuiltShimTicks>
      <_TcsNativeShimTime>$([System.IO.File]::GetLastWriteTime('$(_TcsNativeShimFull)').ToString('yyyy-MM-dd HH:mm:ss'))</_TcsNativeShimTime>
      <_TcsBuiltShimTime>$([System.IO.File]::GetLastWriteTime('$(_TcsBuiltShimFull)').ToString('yyyy-MM-dd HH:mm:ss'))</_TcsBuiltShimTime>
      <_TcsBuiltShimIsNewer>$([System.Int64]::Parse('$(_TcsBuiltShimTicks)').CompareTo($([System.Int64]::Parse('$(_TcsNativeShimTicks)'))))</_TcsBuiltShimIsNewer>
    </PropertyGroup>

    <Error Condition="'$(_TcsBuiltShimIsNewer)' == '1' And '$(AllowStaleNativeShim)' != 'true'"
           Code="TCS0001"
           Text="native\ の tcs_gstreamer.dll が $(TcsShimBuildDirName) の出力より古いため、ビルドを止めます（native\ の DLL が優先されるので、このままでは古い shim で走ります）。native\: $(_TcsNativeShimFull)（更新 $(_TcsNativeShimTime)）／$(TcsShimBuildDirName): $(_TcsBuiltShimFull)（更新 $(_TcsBuiltShimTime)）。解き方: native\ の DLL を消す（$(TcsShimBuildDirName) の出力が使われる）か、$(TcsShimBuildDirName) の DLL を native\ へ写す。わざと古い shim で走らせるときは -p:AllowStaleNativeShim=true。" />

    <Warning Condition="'$(_TcsBuiltShimIsNewer)' == '1' And '$(AllowStaleNativeShim)' == 'true'"
             Code="TCS0002"
             Text="AllowStaleNativeShim=true: 古い native\ の shim を使います。使う: $(_TcsNativeShimFull)（更新 $(_TcsNativeShimTime)）／使わない新しい方: $(_TcsBuiltShimFull)（更新 $(_TcsBuiltShimTime)）。" />
  </Target>
</Project>
