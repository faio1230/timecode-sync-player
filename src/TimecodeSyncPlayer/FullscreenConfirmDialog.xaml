<Window x:Class="TimecodeSyncPlayer.FullscreenConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="全画面の確認"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#1C1C1C"
        AutomationProperties.AutomationId="FullscreenConfirmDialog">
    <!-- v0.6.6 R-8: 主画面（作業中の画面）に全画面を出す前の確認。既定（Enter）と Esc は「やめる」。
         ボタンの見た目は MainWindow の暗いテンプレートを持ち主から引き継ぐ（コードビハインド）。 -->
    <StackPanel Margin="16">
        <TextBlock AutomationProperties.AutomationId="FullscreenConfirmMessage"
                   Text="作業中の画面（プライマリ）に全画面を出します。出している間、このアプリの操作の画面は隠れて見えません。"
                   Foreground="White" TextWrapping="Wrap"/>
        <TextBlock AutomationProperties.AutomationId="FullscreenConfirmEscHint"
                   Text="戻すときは Esc を押します。"
                   Foreground="#D7A24B" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnShow" Content="出す" Width="84" Height="30"
                    Click="BtnShow_Click"
                    AutomationProperties.AutomationId="BtnFullscreenConfirmShow"/>
            <Button x:Name="BtnCancel" Content="やめる" Width="100" Height="30"
                    Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True"
                    AutomationProperties.AutomationId="BtnFullscreenConfirmCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
