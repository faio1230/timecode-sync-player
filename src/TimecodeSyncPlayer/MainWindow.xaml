<Window x:Class="TimecodeSyncPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TimecodeSyncPlayer"
        Width="1120" Height="680"
        MinWidth="980" MinHeight="600"
        Background="#111"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <local:OnLabelConverter x:Key="OnLabel"/>
        <local:ButtonToolTipConverter x:Key="ButtonToolTip"/>
        <!-- v0.6.6 R-2: キーボードで移ったときだけ出るフォーカスの枠 -->
        <Style x:Key="ButtonFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" RadiusX="2" RadiusY="2"
                                   Stroke="#5AA0E6" StrokeThickness="1" StrokeDashArray="2 2"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- v0.6.6 R-2・R-6・R-7: ボタンのテンプレート。無効は暗い背景に薄い文字（WPF の既定の明るい灰色は暗い画面から浮く）。
             乗せた・押した・キーボードのフォーカスもここで作る。ButtonLook.IsOn が真なら緑の縁と背景（ON/OFF のボタン）。
             無効のボタンでもツールチップ（押せない理由）を出す。 -->
        <Style TargetType="Button">
            <Setter Property="Background"   Value="#2A2A2A"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,5"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:ButtonLook.IsOn" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3B26"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3FB950"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A8A8A"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="local:ButtonLook.IsOn" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#27502F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#56D364"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#161616"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B0B0B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2C2C2C"/>
                                <Setter Property="Foreground" Value="#5A5A5A"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False"/>
                                    <Condition Property="local:ButtonLook.IsOn" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#17261A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F6B3A"/>
                                <Setter Property="Foreground" Value="#7FA187"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- メニューバー -->
            <RowDefinition Height="*"/>     <!-- 映像 -->
            <RowDefinition Height="Auto"/>  <!-- シークバー -->
            <RowDefinition Height="Auto"/>  <!-- コントロール -->
            <RowDefinition Height="Auto"/>  <!-- タイムライン -->
        </Grid.RowDefinitions>

        <!-- メニューバー -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                    Background="#1C1C1C" Margin="6,4">
            <Button Content="📂 開く" Width="90" Height="30"
                    ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Open}"
                    Click="BtnOpen_Click"
                    AutomationProperties.AutomationId="BtnOpen"/>
            <TextBlock Text="Display:" Foreground="#BBBBBB"
                       VerticalAlignment="Center" Margin="16,0,6,0"/>
            <ComboBox x:Name="DisplayCombo"
                      Width="180" Height="30"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="DisplayCombo_SelectionChanged"
                      AutomationProperties.AutomationId="DisplayCombo"/>
            <Button x:Name="BtnFullscreen"
                    Content="FULLSCREEN" Width="120" Height="30"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Fullscreen}"
                    Click="BtnFullscreen_Click"
                    AutomationProperties.AutomationId="BtnFullscreen"/>
        </StackPanel>

        <!-- 映像エリア（SW レンダーの WriteableBitmap を表示） -->
        <Border Grid.Row="1" Grid.Column="0" Background="Black">
            <Grid>
                <Image x:Name="VideoImage"
                       AutomationProperties.AutomationId="VideoImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- R1 1-2: GPU 出力が使えないときはここに理由を表示し、再生は行わない -->
                <StackPanel x:Name="PlaybackUnavailablePanel"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="映像出力を利用できません"
                               AutomationProperties.AutomationId="PlaybackUnavailableText"
                               Foreground="#DDDDDD" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PlaybackUnavailableDetailText"
                               AutomationProperties.AutomationId="PlaybackUnavailableDetailText"
                               Foreground="#888888" FontSize="11" TextWrapping="Wrap"
                               MaxWidth="640" Margin="0,10,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- シークバー -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="10,6,10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="SeekBar"
                    AutomationProperties.AutomationId="SeekBar"
                     Minimum="0" Maximum="{Binding Player.SeekBarMaximum, Mode=OneWay}"
                     Value="{Binding Player.SeekBarValue, Mode=OneWay}"
                    IsMoveToPointEnabled="True"
                    PreviewMouseMove="Seek_MouseMove"
                    PreviewMouseUp="Seek_MouseUp"
                    LostMouseCapture="Seek_LostMouseCapture"
                    ValueChanged="Seek_ValueChanged"/>
            <TextBlock x:Name="TimeLabel"
                       AutomationProperties.AutomationId="TimeLabel"
                       Grid.Column="1"
                       Foreground="#BBBBBB"
                       FontFamily="Consolas" FontSize="13"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Text="{Binding Player.TimeLabel}"/>
            <TextBlock AutomationProperties.AutomationId="MetaLineText"
                       Grid.Column="2"
                       Foreground="#BBBBBB"
                       FontFamily="Consolas" FontSize="11"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       MaxWidth="300"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Player.MetaLine}"/>
        </Grid>

        <!-- 再生コントロール -->
        <!-- v0.6.6: 窓が狭いときも中央の再生の並びを切らないため、右側の並びの最大の幅を
             ControlRow_SizeChanged が決める（ControlRowLayout）。右側は収まらなければ下の行へ折り返す。 -->
        <Grid x:Name="ControlRow" Grid.Row="3" Grid.Column="0" Margin="10,4,10,12"
              SizeChanged="ControlRow_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ControlRowLeft" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="|◀" Width="46" Height="36"
                        ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=PreviousTrack}"
                        Margin="0,0,6,0" Click="BtnPreviousTrack_Click"
                        AutomationProperties.AutomationId="BtnPreviousTrack"/>
                <Button Content="▶|" Width="46" Height="36"
                        ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=NextTrack}"
                        Margin="0,0,10,0" Click="BtnNextTrack_Click"
                        AutomationProperties.AutomationId="BtnNextTrack"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="TransportButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="◀◀" Width="54" Height="38"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Back}"
                            Margin="4,0" Command="{Binding Player.BackCommand}"
                            AutomationProperties.AutomationId="BtnBack"/>
                    <Button Content="-1F" Width="46" Height="38"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=FrameBack}"
                            Margin="4,0" Command="{Binding Player.FrameBackCommand}"
                            AutomationProperties.AutomationId="BtnFrameBack"/>
                    <Button x:Name="BtnPlay" Width="68" Height="38"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=PlayPause}"
                            Margin="4,0" Command="{Binding Player.PlayPauseCommand}"
                            Content="{Binding Player.PlayPauseIcon}"
                            AutomationProperties.AutomationId="BtnPlay"/>
                    <Button Content="+1F" Width="46" Height="38"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=FrameForward}"
                            Margin="4,0" Command="{Binding Player.FrameFwdCommand}"
                            AutomationProperties.AutomationId="BtnFrameFwd"/>
                    <Button Content="▶▶" Width="54" Height="38"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Forward}"
                            Margin="4,0" Command="{Binding Player.FwdCommand}"
                            AutomationProperties.AutomationId="BtnFwd"/>
                </StackPanel>
                <TextBlock Text="{Binding Sync.LtcSignalLossPauseReason}"
                           AutomationProperties.AutomationId="LtcSignalLossPauseReason"
                           Foreground="#D7A24B" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.LtcSignalLossPauseReason}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 部品ごとに折り返す（音量の文字とつまみ、速度の文字とボタンは 1 組で動かす） -->
            <WrapPanel x:Name="ControlRowRight" Grid.Column="2" Orientation="Horizontal"
                       VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="BtnMute"
                        Content="{Binding Player.MuteToggleLabel}"
                        local:ButtonLook.IsOn="{Binding Player.MuteToggleLabel, Converter={StaticResource OnLabel}}"
                        ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Mute}"
                        Width="88" Height="34" Margin="10,2,0,2"
                        Click="BtnMute_Click"
                        AutomationProperties.AutomationId="BtnMute"/>
                <StackPanel Orientation="Horizontal" Margin="10,2,0,2">
                    <TextBlock Text="音量:" Foreground="#888"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="VolumeSlider"
                            Width="100"
                            VerticalAlignment="Center"
                            Minimum="0" Maximum="100"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Player.Volume, Mode=OneWay}"
                            ValueChanged="VolumeSlider_ValueChanged"
                            AutomationProperties.AutomationId="VolumeSlider"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,2,0,2">
                    <TextBlock Text="速度:" Foreground="#888"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="{Binding Player.SpeedLabel}" Width="52" Height="34"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Speed}"
                            Command="{Binding Player.SpeedCommand}"
                            AutomationProperties.AutomationId="BtnSpeed"/>
                </StackPanel>
                <Button x:Name="BtnSpout" Content="{Binding Sync.SpoutToggleLabel}" Width="88" Height="34"
                        local:ButtonLook.IsOn="{Binding Sync.SpoutToggleLabel, Converter={StaticResource OnLabel}}"
                        ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Spout}"
                        Margin="10,2,0,2" Click="BtnSpout_Click"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="BtnSpout"/>
                <Button x:Name="BtnTestCard" Content="{Binding Output.TestCardToggleLabel}" Width="88" Height="34"
                        local:ButtonLook.IsOn="{Binding Output.TestCardToggleLabel, Converter={StaticResource OnLabel}}"
                        ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=TestCard}"
                        Margin="10,2,0,2" Click="BtnTestCard_Click"
                        AutomationProperties.AutomationId="BtnTestCard"/>
                <Button x:Name="BtnTimeline" Content="{Binding Sync.TimelineToggleLabel}" Width="96" Height="34"
                        local:ButtonLook.IsOn="{Binding Sync.TimelineToggleLabel, Converter={StaticResource OnLabel}}"
                        ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=Timeline}"
                        Margin="10,2,0,2" Click="BtnTimeline_Click"
                        AutomationProperties.AutomationId="BtnTimeline"/>
            </WrapPanel>
        </Grid>

        <!-- タイムライン -->
        <Border x:Name="TimelineContainer"
                Grid.Row="4" Grid.Column="0"
                Visibility="Collapsed"
                BorderBrush="#333" BorderThickness="0,1,0,0"/>

        <!-- Playlist -->
        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="5"
                Background="#171717" BorderBrush="#303030" BorderThickness="1,0,0,0">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- LTCタイトル -->
                    <RowDefinition Height="Auto"/>  <!-- デバイス選択 -->
                    <RowDefinition Height="Auto"/>  <!-- FPSモード -->
                    <RowDefinition Height="Auto"/>  <!-- Sync Mode + Gap Behavior -->
                    <RowDefinition Height="Auto"/>  <!-- START/STOP/Sync -->
                    <RowDefinition Height="Auto"/>  <!-- タイムコード表示 -->
                    <RowDefinition Height="Auto"/>  <!-- 出力タイトル -->
                    <RowDefinition Height="Auto"/>  <!-- 出力設定 -->
                    <RowDefinition Height="Auto"/>  <!-- Playlistタイトル -->
                    <RowDefinition Height="Auto"/>  <!-- 自動オフセットチェックボックス -->
                    <RowDefinition Height="Auto"/>  <!-- Playlistボタン -->
                    <RowDefinition Height="Auto"/>  <!-- 保存/読み込みボタン -->
                    <RowDefinition Height="*"/>     <!-- Playlistリスト -->
                    <RowDefinition Height="Auto"/>  <!-- CurrentTrackLabel -->
                </Grid.RowDefinitions>

                <TextBlock Text="LTC"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LtcDeviceCombo"
                              AutomationProperties.AutomationId="LtcDeviceCombo"
                              Height="28"
                              Background="White"
                              Foreground="Black"
                              SelectionChanged="LtcDeviceCombo_SelectionChanged"
                              SelectedItem="{Binding Sync.SelectedDevice, Mode=TwoWay}">
                    </ComboBox>
                    <Button Content="更新" Grid.Column="1" Width="50" Height="28"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=RefreshLtcDevices}"
                            Margin="6,0,0,0" Click="BtnRefreshLtcDevices_Click"
                            AutomationProperties.AutomationId="BtnRefreshLtcDevices"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="FPS:" Foreground="#BBBBBB"
                               Grid.Row="0" Grid.Column="0"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LtcFpsModeCombo"
                              Grid.Row="0" Grid.Column="1"
                              AutomationProperties.AutomationId="LtcFpsModeCombo"
                              Height="28"
                              ToolTip="本番では LTC の発生器と同じ fps に固定してください"
                              SelectedIndex="{Binding Sync.LtcFpsModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Auto" Tag="Auto"/>
                        <ComboBoxItem Content="24 fps" Tag="Fixed24"/>
                        <ComboBoxItem Content="25 fps" Tag="Fixed25"/>
                        <ComboBoxItem Content="29.97 fps" Tag="Fixed29_97"
                                      ToolTip="29.97 のノンドロップの信号はこれを選んでください。ドロップフレームは Auto でも判定できます"/>
                        <ComboBoxItem Content="30 fps" Tag="Fixed30"/>
                    </ComboBox>
                    <TextBlock Text="補正:" Foreground="#BBBBBB"
                               Grid.Row="0" Grid.Column="2"
                               VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <ComboBox x:Name="SyncCorrectionModeCombo"
                              Grid.Row="0" Grid.Column="3"
                              AutomationProperties.AutomationId="SyncCorrectionModeCombo"
                              Height="28"
                              SelectedIndex="{Binding Sync.SyncCorrectionModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Smooth" Tag="Smooth"/>
                        <ComboBoxItem Content="Jump" Tag="Jump"/>
                    </ComboBox>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                        <!-- v0.6.4: Auto の注記は補正の状態の行に重ねる（行を足さず、下の操作を動かさない） -->
                        <Grid>
                            <TextBlock x:Name="SyncCorrectionStatusText"
                                       AutomationProperties.AutomationId="SyncCorrectionStatusText"
                                       Foreground="#FFB300" FontSize="11" Margin="0,4,0,0"
                                       Text="{Binding Sync.SyncCorrectionStatus}"/>
                            <TextBlock x:Name="LtcFpsAutoNoteText"
                                       AutomationProperties.AutomationId="LtcFpsAutoNoteText"
                                       Text="Auto は確認用です。本番は固定にしてください"
                                       Foreground="#888888" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding Sync.ShowLtcFpsAutoNote, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <TextBlock x:Name="LongGopWarningText"
                                   AutomationProperties.AutomationId="LongGopWarningText"
                                   Foreground="#D7A24B" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding Sync.LongGopWarning}"/>
                        <TextBlock x:Name="CodecWarningText"
                                   AutomationProperties.AutomationId="CodecWarningText"
                                   Foreground="#D7A24B" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding Sync.CodecWarning}"/>
                        <TextBlock x:Name="DecodeHealthWarningText"
                                   AutomationProperties.AutomationId="DecodeHealthWarningText"
                                   Foreground="#FF8A65" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding Sync.DecodeHealthWarning}"/>
                    </StackPanel>
                    <TextBlock Text="オフセット:" Foreground="#BBBBBB"
                               Grid.Row="2" Grid.Column="0"
                               VerticalAlignment="Center" Margin="0,6,8,0"/>
                    <!-- v0.6.6: 「オフセット: [つまみ] [入力欄] ms」の 1 行と注記の 1 行。値は入力欄だけで見せる
                         （前は値の文字「+40 ms」と入力欄「+40」で同じ値を 2 回見せていた） -->
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SyncOffsetSlider"
                                AutomationProperties.AutomationId="SyncOffsetSlider"
                                VerticalAlignment="Center"
                                Minimum="-1000" Maximum="1000"
                                SmallChange="1" LargeChange="10"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Sync.SyncOffsetMs, Mode=TwoWay}"/>
                        <!-- R-9: オフセットの数値入力。ms の整数。Enter か欄を離れたときに反映し、Esc で戻す。幅は「-1000」が収まる幅 -->
                        <TextBox x:Name="SyncOffsetInputBox"
                                 Grid.Column="1"
                                 AutomationProperties.AutomationId="SyncOffsetInputBox"
                                 Width="52" Height="20" Margin="6,0,0,0" Padding="2,0"
                                 FontSize="11" VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Right"
                                 Foreground="White" Background="#2A2A2A" BorderBrush="#4A4A4A"
                                 ToolTip="オフセット（ms、整数）。＋で映像が先行。Enter か欄を離れると反映、Esc で戻す"
                                 Text="{Binding Sync.SyncOffsetInputText, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                 KeyDown="SyncOffsetInputBox_KeyDown"
                                 LostKeyboardFocus="SyncOffsetInputBox_LostKeyboardFocus"/>
                        <TextBlock Grid.Column="2" Text="ms" Foreground="#BBBBBB" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Margin="0,4,0,0"
                               Text="＋で映像が先行（下流の遅延を補正）"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="SyncOffsetHintText"
                               Foreground="#888888" FontSize="11"/>
                    <!-- v0.6.0: 幅が足りないときは「再起動の後に反映」を下の行へ折り返す -->
                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="ProRes の GPU デコード:" Foreground="#BBBBBB"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProResGpuCombo"
                                  AutomationProperties.AutomationId="ProResGpuCombo"
                                  Width="80" Height="28"
                                  ToolTip="自動・有効: どの GPU でも使う（NVIDIA 以外は未検証）。無効: CPU でデコード。GPU のデコードに 1 回失敗すると、その起動の間は CPU でデコードする"
                                  SelectedIndex="{Binding Sync.ProResGpuModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="自動" Tag="auto"/>
                            <ComboBoxItem Content="有効" Tag="on"/>
                            <ComboBoxItem Content="無効" Tag="off"/>
                        </ComboBox>
                        <TextBlock x:Name="ProResGpuRestartNoticeText"
                                   AutomationProperties.AutomationId="ProResGpuRestartNoticeText"
                                   Foreground="#FFB300" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Text="{Binding Sync.ProResGpuRestartNotice}"/>
                    </WrapPanel>
                </Grid>

                <UniformGrid Grid.Row="3" Rows="1" Columns="3" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Mode:" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="SyncModeCombo"
                                  AutomationProperties.AutomationId="SyncModeCombo"
                                  Height="26"
                                  SelectedIndex="{Binding Sync.SyncModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Single" Tag="Single"/>
                            <ComboBoxItem Content="Continue" Tag="Continue"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="Gap:" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="GapBehaviorCombo"
                                  AutomationProperties.AutomationId="GapBehaviorCombo"
                                  Height="26"
                                  SelectedIndex="{Binding Sync.GapBehaviorIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding Sync.IsContinueMode}">
                            <ComboBoxItem Content="Black" Tag="Black"/>
                            <ComboBoxItem Content="Freeze" Tag="Freeze"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="信号断時:" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="LtcSignalLossModeCombo"
                                  AutomationProperties.AutomationId="LtcSignalLossModeCombo"
                                  Height="26"
                                  SelectedIndex="{Binding Sync.LtcSignalLossModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="ランスルー" Tag="RunThrough"/>
                            <ComboBoxItem Content="停止" Tag="Stop"/>
                        </ComboBox>
                    </StackPanel>
                </UniformGrid>

                <Grid Grid.Row="4" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnStartLtc" Content="START" Height="28"
                            local:ButtonLook.IsOn="{Binding Sync.IsLtcRunning}"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=StartLtc}"
                            Margin="0,0,3,0" Command="{Binding Sync.StartLtcCommand}"
                            AutomationProperties.AutomationId="BtnStartLtc"/>
                    <Button x:Name="BtnStopLtc" Content="STOP" Grid.Column="1" Height="28"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=StopLtc}"
                            Margin="3,0,3,0" Command="{Binding Sync.StopLtcCommand}"
                            AutomationProperties.AutomationId="BtnStopLtc"/>
                    <Button x:Name="BtnToggleSync" Content="{Binding Sync.SyncToggleLabel}" Grid.Column="2" Height="28"
                            local:ButtonLook.IsOn="{Binding Sync.SyncToggleLabel, Converter={StaticResource OnLabel}}"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=ToggleSync}"
                            Margin="3,0,0,0" Command="{Binding Sync.ToggleSyncCommand}"
                            AutomationProperties.AutomationId="BtnToggleSync"/>
                </Grid>

                <StackPanel Grid.Row="5" Margin="0,0,0,10">
                    <TextBlock x:Name="LtcTimecodeText"
                               AutomationProperties.AutomationId="LtcTimecodeText"
                               AutomationProperties.ItemStatus="{Binding Sync.LtcTimecodeForeground}"
                                Text="{Binding Sync.LtcTimecodeText}"
                                Foreground="{Binding Sync.LtcTimecodeForeground}"
                               FontFamily="Consolas"
                               FontSize="26"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LtcRealTimeText"
                               AutomationProperties.AutomationId="LtcRealTimeText"
                                Text="{Binding Sync.LtcRealTimeText}"
                                Foreground="#BBBBBB"
                               FontFamily="Consolas"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="LtcFormatText"
                               AutomationProperties.AutomationId="LtcFormatText"
                                Text="{Binding Sync.LtcFormatText}"
                                Foreground="#888888"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="6"
                           Text="出力"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <StackPanel Grid.Row="7" x:Name="CanvasGroup" Margin="0,0,0,10"
                            ToolTipService.ShowOnDisabled="True">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="キャンバス:" Foreground="#BBBBBB" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CanvasPresetCombo" Grid.Column="1" Height="26"
                                  AutomationProperties.AutomationId="CanvasPresetCombo"
                                  SelectionChanged="CanvasPresetCombo_SelectionChanged">
                            <ComboBoxItem Content="1920×1080" Tag="1920x1080"/>
                            <ComboBoxItem Content="3840×2160" Tag="3840x2160"/>
                            <ComboBoxItem Content="1080×1920（縦）" Tag="1080x1920"/>
                            <ComboBoxItem Content="カスタム" Tag="custom"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="幅:" Foreground="#BBBBBB" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="CanvasWidthBox" Grid.Column="1" Height="24" Width="72"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.AutomationId="CanvasWidthBox"
                                 Text="1920"/>
                        <TextBlock Text="高さ:" Grid.Column="2" Foreground="#BBBBBB" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBox x:Name="CanvasHeightBox" Grid.Column="3" Height="24" Width="72"
                                 HorizontalAlignment="Left"
                                 AutomationProperties.AutomationId="CanvasHeightBox"
                                 Text="1080"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="配置:" Foreground="#BBBBBB" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CanvasFitCombo" Grid.Column="1" Height="26"
                                  AutomationProperties.AutomationId="CanvasFitCombo">
                            <ComboBoxItem Content="高さ合わせ" Tag="fit-height"/>
                            <ComboBoxItem Content="幅合わせ" Tag="fit-width"/>
                        </ComboBox>
                    </Grid>
                    <Button x:Name="BtnApplyCanvas" Content="キャンバスを適用" Height="28"
                            ToolTip="キャンバスの大きさと配置を出力へ適用する"
                            Click="BtnApplyCanvas_Click"
                            AutomationProperties.AutomationId="BtnApplyCanvas"/>
                    <!-- v0.6.6 R-11: Spout が ON のときだけ送信名を出す（色は ON のボタンの緑にそろえる） -->
                    <TextBlock x:Name="SpoutStatusText"
                               Text="{Binding Output.SpoutStatusText}"
                               AutomationProperties.AutomationId="SpoutStatusText"
                               ToolTip="Spout の送信名（受け側ではこの名前を選ぶ）"
                               Foreground="#56D364" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Output.SpoutStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="GpuStatusText"
                               AutomationProperties.AutomationId="GpuStatusText"
                               Foreground="#D7A24B" FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                    <Button x:Name="BtnGpuRetry" Content="再試行" Height="28"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=GpuRetry}"
                            Visibility="Collapsed"
                            Margin="0,4,0,0"
                            Click="BtnGpuRetry_Click"
                            AutomationProperties.AutomationId="BtnGpuRetry"/>
                </StackPanel>

                <TextBlock Grid.Row="8"
                           Text="Playlist"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <CheckBox x:Name="AutoOffsetCheckBox"
                          Grid.Row="9"
                          Content="自動オフセット（追加時に後ろに配置）"
                          Foreground="#BBBBBB"
                          FontSize="11"
                          Margin="0,0,0,6"
                          IsChecked="True"
                          Checked="AutoOffsetCheckBox_Changed"
                          Unchecked="AutoOffsetCheckBox_Changed"
                          AutomationProperties.AutomationId="AutoOffsetCheckBox"/>

                <UniformGrid Grid.Row="10" Columns="3" Margin="-3,0,-3,6">
                    <Button Content="追加" Height="28"
                            Margin="3" Click="BtnAddToPlaylist_Click"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=AddToPlaylist}"
                            AutomationProperties.AutomationId="BtnAddToPlaylist"/>
                    <Button Content="削除" Height="28"
                            Margin="3" Command="{Binding Playlist.RemoveTrackCommand}"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=RemoveFromPlaylist}"
                            AutomationProperties.AutomationId="BtnRemoveFromPlaylist"/>
                    <Button Content="クリア" Height="28"
                            Margin="3" Command="{Binding Playlist.ClearTracksCommand}"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=ClearPlaylist}"
                            AutomationProperties.AutomationId="BtnClearPlaylist"/>
                    <Button Content="上へ" Height="28"
                            Margin="3" Command="{Binding Playlist.MoveUpCommand}"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=MoveTrackUp}"
                            AutomationProperties.AutomationId="BtnMoveTrackUp"/>
                    <Button Content="下へ" Height="28"
                            Margin="3" Command="{Binding Playlist.MoveDownCommand}"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=MoveTrackDown}"
                            AutomationProperties.AutomationId="BtnMoveTrackDown"/>
                </UniformGrid>

                <UniformGrid Grid.Row="11" Columns="2" Margin="-3,0,-3,6">
                    <Button Content="保存" Height="28"
                            Margin="3" Click="BtnSaveProject_Click"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=SaveProject}"
                            AutomationProperties.AutomationId="BtnSaveProject"/>
                    <Button Content="読み込み" Height="28"
                            Margin="3" Click="BtnLoadProject_Click"
                            ToolTip="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ButtonToolTip}, ConverterParameter=LoadProject}"
                            AutomationProperties.AutomationId="BtnLoadProject"/>
                </UniformGrid>

                <ListBox x:Name="PlaylistList"
                         Grid.Row="12"
                         AutomationProperties.AutomationId="PlaylistList"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AllowDrop="True"
                         Background="#101010"
                         BorderBrush="#3A3A3A"
                         Foreground="White"
                         PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="PlaylistList_PreviewMouseMove"
                         DragOver="PlaylistList_DragOver"
                         Drop="PlaylistList_Drop"
                         SelectionChanged="PlaylistList_SelectionChanged"
                         MouseDoubleClick="PlaylistList_MouseDoubleClick"
                         ContextMenuOpening="PlaylistList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="配置" AutomationProperties.AutomationId="TrackFitMenu">
                                <MenuItem Header="プロジェクト既定" Click="TrackFitMenuItem_Click"/>
                                <MenuItem Header="高さ合わせ" Tag="fit-height" Click="TrackFitMenuItem_Click"/>
                                <MenuItem Header="幅合わせ" Tag="fit-width" Click="TrackFitMenuItem_Click"/>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <DockPanel>
                                    <TextBlock x:Name="LongGopWarningText"
                                               DockPanel.Dock="Right"
                                               Text="{Binding LongGopWarningText}"
                                               ToolTip="{Binding LongGopWarningTooltip}"
                                               Foreground="#D7A24B"
                                               FontSize="10"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CodecWarningText"
                                               DockPanel.Dock="Right"
                                               Text="{Binding CodecWarningText}"
                                               ToolTip="{Binding CodecWarningTooltip}"
                                               Foreground="#D7A24B"
                                               FontSize="10"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilePath}"
                                               FontSize="13"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock x:Name="TimelineRangeTextBlock"
                                               Foreground="#666666"
                                               FontSize="10"
                                               FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis"
                                               Text=""/>
                                </StackPanel>
                                 <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                     <TextBlock Text="Offset:"
                                                Foreground="#888888"
                                                FontSize="9"
                                                FontFamily="Consolas"
                                                Margin="8,0,4,0"/>
                                    <TextBox x:Name="TimelineOffsetTextBox"
                                             AutomationProperties.AutomationId="TimelineOffsetTextBox"
                                             Width="80"
                                             Height="18"
                                             FontSize="9"
                                             FontFamily="Consolas"
                                             Text="{Binding TimelineOffsetText, Mode=OneWay}"
                                             Foreground="White"
                                             Background="#2A2A2A"
                                             BorderBrush="#4A4A4A"
                                             Padding="2,0"
                                             Tag="{Binding Id}"
                                             LostFocus="TimelineOffsetTextBox_LostFocus"
                                             KeyDown="TimelineOffsetTextBox_KeyDown"/>
                                </StackPanel>
                                <!-- v0.6.6: Dur と Eff は別の行（1 行では列の幅に収まらず Eff の値が右で切れていた） -->
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="Dur:"
                                               Foreground="#888888"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Margin="8,0,4,0"/>
                                    <TextBlock Text="{Binding MediaDurationText}"
                                               Foreground="#666666"
                                               FontSize="9"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text=" Eff:"
                                               Foreground="#888888"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Margin="6,0,4,0"/>
                                    <TextBlock Text="{Binding EffectiveDurationText}"
                                               Foreground="#666666"
                                               FontSize="9"
                                               FontFamily="Consolas"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="CurrentTrackLabel"
                           Grid.Row="13"
                           AutomationProperties.AutomationId="CurrentTrackLabel"
                           Foreground="#BBBBBB"
                            Text="{Binding Playlist.CurrentTrackLabel}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
