  <diagram id="03-sync" name="03  LTC 同期 — 時刻から再生操作まで">
    <mxGraphModel dx="1600" dy="1590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1590" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03  LTC 同期 — 時刻から再生操作まで" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=30;fontColor=#243349;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="LtcSyncController が入口を統括。粗いシーク判断と継続再生中の補正は別の判断器を使う。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=17;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="1520" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="青：制御・状態　　紫：映像データ　　水色の破線：通知" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=14;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="101" width="1020" height="35" as="geometry" />
        </mxCell>
        <mxCell id="version" value="v0.4.7 · a4cb181 · 2026-09-20" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=14;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1250" y="101" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="frame" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;1. LTC フレームを受け取る&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;音声のフレーム終端時刻とタイムコード&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;UI の Dispatcher に渡す&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#148365;margin-top:8px&quot;&gt;LtcAudioMonitor → MainWindow&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#ecfdf5;strokeColor=#148365;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="diagnostics" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;2. fps 解決と信号の診断&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Normal / Jump / Reverse / Duplicate / Invalid&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Jump の確認・保持・信号断の方針を適用&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;LtcFrameProcessor / LtcSyncController&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="585" y="185" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="effective" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;3. 同期に使う時刻を作る&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;通常受信：LTC 秒＋受信後の経過＋offset&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;保持値の適用などでは経過時間を足さない&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;EffectiveSeconds / SyncOffsetPolicy&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1110" y="185" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;信号が止まった場合&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;LtcSignalLossPolicy：RunThrough / Stop&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;タイマーも監視。復帰条件を満たすまで抑止&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#aa8120;margin-top:8px&quot;&gt;LtcSyncController.Tick&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#fffbea;strokeColor=#aa8120;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;4. モードとトラック範囲で分岐&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Sync ON・監視中・プレイヤー準備済みを確認&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Continue はタイムライン上の素材を検索&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;LtcSyncController.ApplySync&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="585" y="390" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="single" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;Single：現在の素材に追従&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;LTC から素材位置を決定&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;MediaIn / MediaOut で境界を制限・保持&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;SingleModeSyncCoordinator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="60" y="595" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="continue" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;Continue：素材を選んで追従&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;TimelineOffset 等から素材内の秒へ変換&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;必要なら素材ロード／Gap 退出を実行&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;PlaylistState / ContinueOnTrackCoordinator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="585" y="595" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;Gap：素材のない区間&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Black または Freeze を決定&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;必要なフレームの取得・保持を調整&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;GapFreezeHandler / GapEnterCoordinator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1110" y="595" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="target" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;素材内の目標位置と再生状態（Single / Continue 共通）&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;モードごとに目標を決めた後、シーク判断と継続再生中の補正を条件に応じて使い分ける。&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;LtcSyncController / 各 Coordinator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="955" height="110" as="geometry" />
        </mxCell>
        <mxCell id="coarse" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;5a. シークするか・待つか&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;ロード安定・位置の信頼性・着地待ち&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;履歴ゲート、debounce、着地所要の学習&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;D → 保留した要求は次回へ&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;TimecodeSyncService / SyncDecisionEngine&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="60" y="1010" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fine" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;5b. 継続再生中のずれを補正&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;補正可能なフレームだけ Controller が実行&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Smooth：速度変更 ／ Jump：シーク&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;SyncCorrectionController&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="585" y="1010" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="visual" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;表示状態を GPU に渡す&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Black / Hold / GapFreeze・配置・世代&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;映像を止める判断と画像の保持を分担&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#8554c2;margin-top:8px&quot;&gt;TimelineOutputState → ComposeLayer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#f5f0ff;strokeColor=#8554c2;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1010" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="execute" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;6. 再生 API で実行&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Load / Seek / SetPaused / SetRateInstant&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;結果・再生位置・到着状況を次回判断に使う&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#bf691e;margin-top:8px&quot;&gt;GstPlaybackApi → native shim&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#fff7ed;strokeColor=#bf691e;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="60" y="1300" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="waiting" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;D｜保留した要求は次回へ&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;新しい受信フレーム／Tick で再評価&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;ロード・シーク発行と実際の着地を区別&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#718096;margin-top:8px&quot;&gt;SyncRequestResult.Deferred&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#f1f5f9;strokeColor=#718096;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="585" y="1300" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="advisory" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;警告と同期制御は別の責務&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;GOP / コーデック / デコード追従の警告&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;素材の交換や設定の判断材料として表示&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#aa8120;margin-top:8px&quot;&gt;GopScanCache / DecodeHealthMonitor&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#fffbea;strokeColor=#aa8120;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1300" width="430" height="135" as="geometry" />
        </mxCell>
        <mxCell id="edge0" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3264c5;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="frame" target="diagnostics">
          <mxGeometry relative="1" as="geometry" />
