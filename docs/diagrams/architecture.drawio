        <mxCell id="note2" value="GStreamer 内部には streaming / bus / pump 等があるため、図の 1 行が必ず 1 本の OS スレッドとは限らない。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=16;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
