        <mxCell id="note0" value="起動条件：D3D11.4 が必須。software decode を選んでも、合成・出力には GPU が必要。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=18;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1126" width="1510" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="復旧の 4 は条件付き。終了図は通常経路の要約。失敗は集約し、安全に解放できない資源は保持する。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=17;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1160" width="1510" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="この図は現行の責務分担を示すもの。再設計案や、以前のレビュー時点の未修正状態を描いたものではない。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=16;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1194" width="1510" height="35" as="geometry" />
        </mxCell>
