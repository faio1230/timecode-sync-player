        <mxCell id="note0" value="5a・5b は UI スレッド上での条件分岐。D は保留要求の接続先。モード別の例外分岐は省略している。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=18;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1466" width="1510" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="位置フィードバックや GOP 由来のシーク先行量には環境変数による実験経路があり、既定経路と区別する。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=16;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1502" width="1510" height="35" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="TimecodeSyncPlayer | 現行コードの構成図 | 主要な経路を要約" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=11;fontColor=#94a3b8;fontStyle=0;" vertex="1" parent="1">
