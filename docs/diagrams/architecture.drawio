  </diagram>
  <diagram id="04-lifecycle" name="04  起動・GPU 復旧・終了">
    <mxGraphModel dx="1600" dy="1290" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1290" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="04  起動・GPU 復旧・終了" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=30;fontColor=#243349;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="1500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="寿命の管理は MainWindow、GstBackendState、RenderSession、OutputEngine に分担されている。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=17;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="1520" height="35" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="青：制御・状態　　紫：映像データ　　水色の破線：通知" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=14;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="101" width="1020" height="35" as="geometry" />
        </mxCell>
        <mxCell id="version" value="v0.4.7 · a4cb181 · 2026-09-20" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Yu Gothic;fontSize=14;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1250" y="101" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="band0" value="起動  /  App → MainWindow" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;fontSize=17;fontStyle=1;fillColor=#f8fafc;strokeColor=#e2e8f0;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="430" height="950" as="geometry" />
        </mxCell>
        <mxCell id="band1" value="復旧  /  OutputEngine → UI" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;fontSize=17;fontStyle=1;fillColor=#f8fafc;strokeColor=#e2e8f0;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="585" y="155" width="430" height="950" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="終了  /  ExitCoordinator" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=15;spacingTop=12;fontSize=17;fontStyle=1;fillColor=#f8fafc;strokeColor=#e2e8f0;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="155" width="430" height="950" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;1. DI・設定・GPU 能力検査&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Singleton を登録、設定とログを準備&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;D3D11.4 非対応なら再生を無効にする&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;App.OnStartup / OutputBackendState&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="80" y="215" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;2. 画面と出力エンジンを生成&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;ViewModels / RenderSession を接続&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;GPU worker 開始 → デバイス情報を shim へ&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;MainWindow constructor / OutputEngine&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;3. WindowLoaded でセッション初期化&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;player 生成、音声設定、通知を登録&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;GStreamerSource を出力エンジンへ接続&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#bf691e;margin-top:8px&quot;&gt;WindowLoadedSessionInitializer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#fff7ed;strokeColor=#bf691e;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="80" y="565" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;4. タイマーと画面を開始&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;タイムライン・操作・プレビューを駆動&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;LTC の開始と Sync ON は操作で切替&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;WindowLoadedCoordinator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;定常動作&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;UI：何をいつ再生するかを判断&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;GPU：届いた画像と表示状態で描画&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#8554c2;margin-top:8px&quot;&gt;各 worker と mailbox&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#f5f0ff;strokeColor=#8554c2;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="80" y="915" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;1. GPU デバイス消失を検出&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;対象は GpuDeviceLostException&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;自動復旧はプロセス寿命で 1 回&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#aa8120;margin-top:8px&quot;&gt;GpuRecoveryState&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#fffbea;strokeColor=#aa8120;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="605" y="215" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;2. 出力を停止・資源を整理&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Spout worker 停止&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;lease 返却・合成資源の破棄&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#8554c2;margin-top:8px&quot;&gt;GpuRecoveryPlan steps 1–2&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#f5f0ff;strokeColor=#8554c2;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="605" y="390" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;3. GPU 出力資源を再構築&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;デバイス → 合成 → 全画面 → Spout&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;最後に GStreamer の共有リングを開き直す&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#8554c2;margin-top:8px&quot;&gt;GpuRecoveryPlan steps 3–7&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#f5f0ff;strokeColor=#8554c2;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="605" y="565" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;4. リング再接続できない場合&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;UI：DetachPlayer → RecreatePlayer&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;AttachPlayer → ソース接続 → 素材再読込&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;MainWindow.OnGStreamerRebindRequested&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="605" y="740" width="390" height="135" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;復旧成功 / 手動再試行&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;成功：通常ループへ戻る&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;復旧失敗・再発：Failed → 再試行ボタン&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#aa8120;margin-top:8px&quot;&gt;GpuRecoveryState / RetryGpuRecovery&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#fffbea;strokeColor=#aa8120;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="605" y="935" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;1. 終了確認&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;確認中も再生・LTC・出力は継続&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;キャンセルで通常動作へ戻る&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;ExitCoordinator / ExitTransitions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1130" y="215" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;2. 新規受付と通知の処理を停止&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;新しい UI／LTC 処理を受け付けない&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;RenderSession.Stop で native 処理を待つ&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;MainWindowResourceDisposer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1130" y="390" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;3. 出力を停止&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;GPU / Spout worker の終了を待つ&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;画像の使用完了と資源の返却を整理&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#8554c2;margin-top:8px&quot;&gt;OutputEngine.Stop&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#f5f0ff;strokeColor=#8554c2;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1130" y="565" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;4. 全画面とタイマーを閉じる&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;swapchain を切り離して子 HWND を閉じる&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;UI タイマーを停止&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#3264c5;margin-top:8px&quot;&gt;CloseFullscreenOutput&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#eff6ff;strokeColor=#3264c5;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1130" y="740" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="&lt;div style=&quot;font-size:18px;font-weight:bold;margin-bottom:10px&quot;&gt;5. 資源を順序付きで解放&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;render context → player → LTC / 出力&lt;/div&gt;&lt;div style=&quot;font-size:15px;line-height:23px&quot;&gt;Spout・タイムライン・RenderSession&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;color:#bf691e;margin-top:8px&quot;&gt;MainWindowResourceDisposer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=16;spacingRight=12;arcSize=12;fillColor=#fff7ed;strokeColor=#bf691e;strokeWidth=1.5;fontFamily=Yu Gothic;fontColor=#243349;" vertex="1" parent="1">
          <mxGeometry x="1130" y="915" width="390" height="135" as="geometry" />
        </mxCell>
